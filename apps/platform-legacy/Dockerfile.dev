FROM node:26

WORKDIR /workspace/apps/platform-legacy

COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh
COPY . /workspace

EXPOSE 4200

ENV EPOS_SERVICE_NAME="Legacy Platform GUI" \
    EPOS_PORT="4200"

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["sh", "-c", "npm install --no-audit --no-fund && exec npm run dev-oss -- --host 0.0.0.0 --proxy-config proxy.tilt.conf.json"]
