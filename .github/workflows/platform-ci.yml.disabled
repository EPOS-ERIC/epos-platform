name: Platform Pipeline

on:
  pull_request:
    paths:
      - "apps/platform/**"
      - "services/gateway/docs/openapi.yaml"
      - "packages/scripts/epos-banner.sh"
      - "Makefile"
      - ".github/workflows/platform-ci.yml"
      - ".github/workflows/_node-app.yml"
  push:
    branches:
      - "main"
    tags:
      - "v*"
    paths:
      - "apps/platform/**"
      - "services/gateway/docs/openapi.yaml"
      - "packages/scripts/epos-banner.sh"
      - "Makefile"
      - ".github/workflows/platform-ci.yml"
      - ".github/workflows/_node-app.yml"

permissions:
  contents: read
  packages: write

jobs:
  ci:
    uses: ./.github/workflows/_node-app.yml
    secrets: inherit
    with:
      app: apps/platform
      image: platform
      dockerfile: apps/platform/Dockerfile
      context: apps/platform
      node-version-file: apps/platform/.nvmrc
      codegen-command: make codegen
