FROM golang:1.27-alpine

RUN apk add --no-cache git curl

WORKDIR /workspace/services/gateway

COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh
COPY . /workspace

EXPOSE 5000

ENV EPOS_SERVICE_NAME="Gateway" \
    EPOS_PORT="5000"

RUN adduser -D -u 1000 appuser && mkdir -p /go/pkg/mod /home/appuser/.cache/go-build && chown -R 1000:1000 /workspace /go/pkg/mod /home/appuser/.cache
USER 1000

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["go", "run", ".", "-config", "/workspace/docker/gateway-config.dev.yaml"]
