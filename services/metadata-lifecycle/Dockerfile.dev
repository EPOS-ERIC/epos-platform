FROM golang:1.27-alpine

RUN apk add --no-cache git make

WORKDIR /workspace/services/metadata-lifecycle

COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh

RUN go install github.com/grpc-ecosystem/grpc-health-probe@v0.4.42

EXPOSE 5000

ENV EPOS_SERVICE_NAME="Metadata Lifecycle" \
    EPOS_PORT="5000"

RUN adduser -D -u 1000 appuser && chown -R 1000:1000 /workspace
USER 1000

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["make", "dev"]
