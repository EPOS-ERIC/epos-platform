epos:AnnotationShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass oa:Annotation;
    sh:name 'Annotation' ;
    rdfs:label "Annotation"@en  ;
    rdfs:comment "SHACL node shape for Annotation."@en  ;

# ## Mandatory properties

    sh:property [
          sh:path oa:hasBody ;
          sh:name 'Has Body' ;
          sh:description "The object of the relationship is a resource that is a body of the Annotation.";
          sh:datatype xsd:anyURI;
          sh:minCount 1 ;
      ] ;
# ## Optional properties
    sh:property [
          sh:path oa:hasTarget ;
          sh:name 'Has Target' ;
          sh:description "The relationship between an Annotation and its Target.";
          sh:node epos:DatasetShape ;
      ] ;

.
