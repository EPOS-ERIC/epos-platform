@prefix epos: <https://www.epos-eu.org/epos-dcat-ap#> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix cnt: <http://www.w3.org/2011/content#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix spdx: <http://spdx.org/rdf/terms#> .
@prefix vcard: <http://www.w3.org/2006/vcard/ns#> .
@prefix hydra: <http://www.w3.org/ns/hydra/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix http: <http://www.w3.org/2006/http#> .
@prefix locn: <http://www.w3.org/ns/locn#> .
@prefix gsp: <http://www.opengis.net/ont/geosparql#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .

<http://www.epos-eu.org/epos-dcat-ap>
    rdf:type owl:Ontology ;
    dct:abstract "EPOS DCAT Application Profile is an extension of DCAT-AP for solid-Earth sciences communities."@en  ;
    dct:creator [  foaf:name "Luca Trani" ; ] ;
    dct:contributor [foaf:name "Rossana Paciello" ; ] ;
    dct:contributor [foaf:name "Manuela Sbarra" ;  ] ;
    dct:contributor [foaf:name "Damian Ulbricht" ; ] ;
    dct:contributor [foaf:name "Sylvain Grellet" ;  ] ;
    dct:contributor [foaf:name "Andy Riddick" ;  ] ;
    dct:contributor [foaf:name "Xiaoliang Wang" ; ] ;
    dct:contributor [foaf:name "Valerio Vinciarelli" ; ] ;
    dct:created "2018-02-09"^^xsd:date ;
    dct:modified "2026-05-01"^^xsd:date ;
    dct:relation <http://www.w3.org/ns/dcat> ;
    dct:title "EPOS DCAT Application Profile"@en  ;
    rdfs:comment "This document specifies the set of classes, properties and shapes graphs used in the EPOS DCAT Application Profile."@en  ;
    rdfs:label "EPOS-DCAT-Application Profile"@en  ;
    owl:imports <./imports/dash.ttl> ;
    owl:imports <./imports/adms.ttl> ;
    owl:imports <./imports/content.ttl> ;
    owl:imports <./imports/oa.ttl> ;
    owl:imports <./imports/org.ttl> ;
    owl:imports <./imports/spdx.ttl> ;
    owl:imports <./imports/hydra.jsonld> ;
    owl:imports <./imports/wgs84_pos.ttl> ;
    owl:imports <./imports/http.ttl> ;
    owl:imports <./imports/locn.ttl> ;
    owl:imports <./imports/geosparql.ttl> ;
    owl:imports <./imports/dqv.ttl> ;
    #owl:imports <http://www.schema.org> ;
    #owl:imports <http://www.w3.org/2004/02/skos/core> ;
    #owl:imports <http://www.w3.org/2006/vcard/ns> ;
    #owl:imports <http://www.w3.org/2008/05/skos-xl> ;
    owl:imports <./imports/dcat.ttl> ;
    #owl:imports <http://www.w3.org/ns/oa#> ;
    #owl:imports <http://www.w3.org/ns/org#> ;
    #owl:imports <http://xmlns.com/foaf/0.1/> ;
    owl:versionInfo "1.1" ;
    foaf:homepage <http://www.epos-eu.org/epos-dcat-ap> ; .
####
# Classes
####
epos:Equipment
    a owl:Class ;
    rdfs:comment "A generic equipment. E.g. a GPS sensor, a seismic station's channel"@en  ;
    rdfs:isDefinedBy <http://www.epos-eu.org/epos-dcat-ap> ;
    rdfs:label "Equipment"@en  ;
    rdfs:subClassOf rdfs:Resource ;
    rdfs:subClassOf schema:Product ;
.
epos:Facility
    a owl:Class ;
    rdfs:comment "A resource representing a Facility. E.g. a laboratory, a seismic station"@en  ;
    rdfs:isDefinedBy <http://www.epos-eu.org/epos-dcat-ap> ;
    rdfs:label "Facility"@en  ;
    rdfs:subClassOf rdfs:Resource ;
.
epos:Publication
    a owl:Class ;
    rdfs:comment "EPOS specialisation of schema:CreativeWork"@en  ;
    rdfs:isDefinedBy <http://www.epos-eu.org/epos-dcat-ap> ;
    rdfs:label "Publication"@en  ;
    rdfs:subClassOf schema:CreativeWork ;
.
epos:WebService
    a owl:Class ;
    rdfs:comment "A service accessible via a Web API "@en  ;
    rdfs:subClassOf schema:Service;
    rdfs:subClassOf rdfs:Resource ;
    rdfs:label "WebService"@en  ;
    rdfs:isDefinedBy <http://www.epos-eu.org/epos-dcat-ap> ;
.
##Alignment schema:Organization and foaf:Organization##
schema:Organization a owl:Class;
                    owl:equivalentClass foaf:Organization;
                    rdfs:label "Organization"@en;
.
##Alignment schema:Person and foaf:Person##
schema:Person a owl:Class;
              owl:equivalentClass foaf:Person;
              rdfs:label "Person"@en;
.
##Alignment schema:ContactPoint and vcard:Kind##
schema:ContactPoint a owl:Class;
                    owl:equivalentClass vcard:Kind;
                    rdfs:label "ContactPoint"@en;
.
####
# Properties
####
epos:resource
    rdf:type owl:ObjectProperty ;
    rdfs:domain dcat:Catalog ;
    rdfs:range rdfs:Resource;
.
##Alignment dcat:contactPoint and schema:contactPoint##
dcat:contactPoint owl:equivalentProperty schema:contactPoint .
##Alignment dcat:keyword and schema:keywords##
dcat:keyword owl:equivalentProperty schema:keywords .
##Extending range and domain of dcat:contactPoint##
dcat:contactPoint
    rdf:type owl:ObjectProperty ;
    rdfs:domain [ rdf:type owl:Class ;
                  owl:unionOf (dcat:Dataset schema:Organization schema:Person epos:Equipment schema:SoftwareApplication schema:SoftwareSourceCode epos:WebService foaf:Project epos:Facility)];
    rdfs:range [ rdf:type owl:Class ;
                 owl:unionOf (vcard:Kind schema:ContactPoint)];
.
epos:associatedProject
    rdf:type owl:ObjectProperty;
    rdfs:domain schema:Organization ;
    rdfs:range foaf:Project ;
.
epos:annotation
    rdf:type owl:ObjectProperty ;
    rdfs:domain [rdf:type owl:Class ;
                 owl:unionOf (rdfs:Resource foaf:Agent dcat:Distribution)] ;
    rdfs:range oa:Annotation ;
.
##Extending the domain of dcat:theme##
dcat:theme
    rdf:type owl:ObjectProperty ;
    rdfs:comment "The main category/domain of the referred resource."@en  ;
    rdfs:domain [rdf:type owl:Class ;
                 owl:unionOf (rdfs:Resource dcat:Dataset)] ;
    rdfs:range skos:Concept ;
.
epos:dynamicRange
    rdf:type owl:ObjectProperty ;
    rdfs:comment "This property contains the full scale measuring ability, in nT (unit and value)"@en  ;
    rdfs:domain epos:Equipment ;
    rdfs:range schema:QuantitativeValue ;
.
epos:filter
    rdf:type owl:ObjectProperty ;
    rdfs:comment "This property describes the filter that an instrument might apply to produce data"@en  ;
    rdfs:domain epos:Equipment ;
    rdfs:range rdfs:Literal ;
.
epos:samplePeriod
    rdf:type owl:ObjectProperty ;
    rdfs:comment "This property contains the sample period in ms"@en  ;
    rdfs:domain epos:Equipment ;
    rdfs:range schema:QuantitativeValue ;
.
epos:orientation
    rdf:type owl:ObjectProperty ;
    rdfs:comment "This property describes how the instrument is oriented."@en  ;
    rdfs:domain epos:Equipment ;
    rdfs:range rdfs:Literal ;
.
##Spatial properties##
epos:northernmostLatitude
    rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:lat;
    rdfs:comment "The WGS84 upper bound (max) latitude of a SpatialThing (decimal degrees)"
.
epos:southernmostLatitude
    rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:lat;
    rdfs:comment "The WGS84 lower bound (min) latitude of a SpatialThing (decimal degrees)"
.
epos:westernmostLongitude
    rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:long;
    rdfs:comment "The WGS84 lower bound (min) longitude of a SpatialThing (decimal degrees)"
.
epos:easternmostLongitude
    rdf:type owl:DatatypeProperty ;
    rdfs:subPropertyOf geo:long;
    rdfs:comment "The WGS84 upper bound (max) longitude of a SpatialThing (decimal degrees)"
.
##Extending the range of schema:owns##
schema:owns
    rdf:type owl:ObjectProperty ;
    rdfs:domain [rdf:type owl:Class ;
                 owl:unionOf (schema:Person schema:Organization)];
    rdfs:range [rdf:type owl:Class ;
                owl:unionOf (schema:OwnershipInfo schema:Product epos:Facility)];
.
epos:resolution
    rdf:type owl:ObjectProperty ;
    rdfs:comment "This property contains the resolution in nT"@en  ;
    rdfs:domain epos:Equipment ;
    rdfs:range rdfs:Literal ;
.
####
# SHACL Shapes Graphs
####
epos:DateOrDateTimeDataType
    a sh:NodeShape,  rdfs:Class ;
    sh:name 'DateTime Datatype' ;
    rdfs:label "DateTime Datatype"@en  ;
    rdfs:comment "SHACL node shape for DateTime Datatype."@en  ;
    sh:description "It checks that a datatype property receives a date or a dateTime literal"@en  ;
    sh:message "The values must be data typed as either xsd:date or xsd:dateTime"@en  ;
    sh:or ( [ sh:datatype xsd:date ; ]
            [ sh:datatype xsd:dateTime ; ] ) ;
.
epos:ContactPointType
    a sh:NodeShape,  rdfs:Class ;
    sh:name 'ContactPoint Datatype' ;
    rdfs:label "ContactPoint Datatype"@en  ;
    rdfs:comment "SHACL node shape for ContactPoint Datatype."@en  ;
    sh:description "A vcard:Kind or schema:ContactPoint"@en  ;
    sh:message "The values must be data either vcard:Kind or schema:ContactPoint"@en  ;
    sh:or ( [ sh:node epos:ContactPointShape ;
              rdfs:label "Contact point object"@en ; ]
            [ sh:class vcard:Kind ;
              rdfs:label "vCard kind resource"@en ; ]
            [ sh:datatype xsd:anyURI ;
              rdfs:label "Contact point URI"@en ; ]
            [ sh:datatype xsd:string ;
              rdfs:label "Contact point text"@en ; ] ) ;
.
epos:CatalogShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass dcat:Catalog ;
    sh:name 'Catalog' ;
    rdfs:label "Catalog"@en  ;
    rdfs:comment "SHACL node shape for Catalog."@en  ;
####
# Catalog mandatory properties
####
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:description "This property contains a name given to the Catalogue. This property can be repeated for parallel language versions of the name." ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path dct:description ;
          sh:name 'Description' ;
          sh:description "This property contains a free-text account of the Catalogue. This property can be repeated for parallel language versions of the description.";
          sh:datatype xsd:string;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path dct:publisher ;
          sh:name 'Publisher' ;
          sh:description "This property refers to an entity (organisation) responsible for making the Catalogue available.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:or (
                      [sh:node epos:AgentShape ; ]
                      [sh:node epos:OrganizationShape ; ]) ;
      ] ;
    sh:property [
          sh:path dcat:dataset ;
          sh:name 'Dataset' ;
          sh:description "This property links the Catalogue with a Dataset that is part of the Catalogue.";
          sh:node epos:DatasetShape ;
          sh:minCount 1 ;
      ] ;
####
# Catalog recommended properties
####
    sh:property [
          sh:path dct:issued ;
          sh:name 'Issued' ;
          sh:minCount 1 ;
          sh:message "Release date is recommended. Please fill in a value"@en  ;
          sh:node epos:DateOrDateTimeDataType ;
          sh:severity sh:Warning ;
          sh:description "This property contains the date of formal issuance (e.g., publication) of the Catalogue.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:modified ;
          sh:name 'Modified' ;
          sh:minCount 1 ;
          sh:message "Update/modification date is recommended. Please fill in a value"@en  ;
          sh:node epos:DateOrDateTimeDataType ;
          sh:severity sh:Warning ;
          sh:description "This property contains the most recent date on which the Catalogue was modified.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:themeTaxonomy ;
          sh:name 'Theme Taxonomy' ;
          sh:description "This property refers to a knowledge organization system used to classify the Catalogue's Datasets.";
          sh:minCount 1 ;
          sh:message "Theme is recommended. Please fill in a value"@en  ;
          sh:datatype xsd:anyURI;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path foaf:homepage ;
          sh:name 'Homepage' ;
          sh:minCount 1 ;
          sh:message "Homepage is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property refers to a web page that acts as the main page for the Catalogue.";
          sh:maxCount 1 ;
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path dct:license ;
          sh:name 'License' ;
          sh:minCount 1 ;
          sh:or ( [ sh:class dct:LicenseDocument ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:message "License is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property refers to the licence under which the Catalogue can be used or reused.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:language ;
          sh:name 'Language' ;
          sh:description "This property refers to a language used in the textual metadata describing titles, descriptions, etc. of the Datasets in the Catalogue. This property can be repeated if the metadata is provided in multiple languages.";
          sh:minCount 1 ;
          sh:or ( [ sh:class dct:LinguisticSystem ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:message "Language is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
####
# Catalog optional properties
####
    sh:property [
          sh:path dct:hasPart ;
          sh:name 'Has Part' ;
          sh:description "This property refers to a related Catalogue that is part of the described Catalogue";
          sh:node epos:CatalogShape ;
      ] ;
    sh:property [
          sh:path dct:isPartOf ;
          sh:name 'Is Part Of' ;
          sh:description "This property refers to a related Catalogue in which the described Catalogue is physically or logically included.";
          sh:node epos:CatalogShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:rights ;
          sh:name 'Rights' ;
          sh:description "This property refers to a statement that specifies rights associated with the Catalogue.";
          sh:or ( [ sh:class dct:RightsStatement ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:spatial ;
          sh:name 'Spatial' ;
          sh:description "This property refers to a geographical area covered by the Catalogue.";
          sh:node epos:LocationShape ;
      ] ;
    sh:property [
          sh:path dcat:record ;
          sh:name 'Record' ;
          sh:description "This property refers to a Catalogue Record that is part of the Catalogue";
          sh:node epos:CatalogRecordShape ;
      ] ;
    sh:property [
          sh:path epos:resource ;
          sh:name 'Resource' ;
          sh:description "This property links the Catalogue with a Resource.";
          sh:or ( [ sh:class rdfs:Resource ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
      ] ;
.
epos:CatalogRecordShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass dcat:CatalogRecord;
    sh:name 'Catalog Record' ;
    rdfs:label "Catalog Record"@en  ;
    rdfs:comment "SHACL node shape for Catalog Record."@en  ;
####
# CatalogRecord mandatory properties
####
    sh:property [
          sh:path foaf:primaryTopic ;
          sh:name 'Primary Topic' ;
          sh:description "This property links the Catalogue Record to the Dataset described in the record.";
          sh:node epos:DatasetShape ;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path dct:modified ;
          sh:name 'Modified' ;
          sh:description "This property contains the most recent date on which the Catalog Record was modified.";
          sh:maxCount 1 ;
          sh:minCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
####
# CatalogRecord recommended properties
####
    sh:property [
          sh:path dct:identifier ;
          sh:name 'Identifier' ;
          sh:minCount 1 ;
          sh:or ( [sh:datatype xsd:string;]
                  [sh:datatype xsd:anyURI; ] );
          sh:message "Identifier is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the main identifier for the Catalog Record.";
          sh:or ( [sh:datatype xsd:string; ]
                  [sh:datatype xsd:anyURI; ] );
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:conformsTo ;
          sh:name 'Conforms To' ;
          sh:description "This property refers to an Application Profile that the Dataset’s metadata conforms to";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
          sh:minCount 1 ;
          sh:message "ConformsTo is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path adms:status ;
          sh:name 'Status' ;
          sh:description "This property refers to the type of the latest revision of a Dataset's entry in the Catalogue. It MUST take one of the values :created, :updated or :deleted depending on whether this latest revision is a result of a creation, update or deletion.";
          sh:maxCount 1 ;
          sh:datatype xsd:anyURI;
          sh:minCount 1 ;
          sh:message "Status is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dct:issued ;
          sh:name 'Issued' ;
          sh:description "This property contains the date on which the description of the Dataset was included in the Catalogue.";
          sh:maxCount 1 ;
          sh:minCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
          sh:message "Issued is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
####
# CatalogRecord optional properties
####
    sh:property [
          sh:path dct:language ;
          sh:name 'Language' ;
          sh:description "This property refers to a language used in the textual metadata describing titles, descriptions, etc. of the Dataset. This property can be repeated if the metadata is provided in multiple languages.";
          sh:or ( [ sh:class dct:LinguisticSystem ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
      ] ;
    sh:property [
          sh:path dct:source ;
          sh:name 'Source' ;
          sh:description "This property refers to the original metadata that was used in creating metadata for the Dataset";
          sh:node epos:CatalogRecordShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:description "This property contains a name given to the Catalogue Record. This property can be repeated for parallel language versions of the name.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path dct:description ;
          sh:name 'Description' ;
          sh:description "This property contains a free-text account of the record. This property can be repeated for parallel language versions of the description.";
          sh:datatype xsd:string;
      ] ;
.
epos:PersonShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:Person;
    sh:name 'Person' ;
    rdfs:label "Person"@en  ;
    rdfs:comment "SHACL node shape for Person."@en  ;
####
# Person mandatory properties
####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Person (e.g.,ORCID, ScopusID, etc.).";
          sh:or ([sh:datatype xsd:string;]
                 [ sh:datatype xsd:anyURI; ]
                 [sh:node epos:PropertyValueShape;]) ;
          sh:minCount 1 ;
      ] ;
####
# Person optional properties
####
    sh:property [
          sh:path schema:givenName ;
          sh:name 'Given Name' ;
          sh:description "This property contains the first name of the Person.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:familyName ;
          sh:name 'Family Name' ;
          sh:description "This property contains the last name of the Person.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property refers to the Contact Point role defined for the Person.";
          sh:node epos:ContactPointType ;
      ] ;
    sh:property [
          sh:path schema:address ;
          sh:name 'Address' ;
          sh:description "This property contains the physical address of the Person.";
          sh:or ([sh:datatype xsd:string ;]
                 [sh:node epos:PostalAddressShape; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:email ;
          sh:name 'Email' ;
          sh:description "This property contains the email address of the Person.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:qualifications ;
          sh:name 'Qualifications' ;
          sh:description "This property contains the specific qualifications of the Person.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:telephone ;
          sh:name 'Telephone' ;
          sh:description "This property contains the telephone number of the Person.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:url ;
          sh:name 'URL' ;
          sh:description "This property refers to the URL of the Person curriculum vitae.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:affiliation ;
          sh:name 'Affiliation' ;
          sh:description "This property refers to the organization to which the person is affiliated.";
          sh:node epos:OrganizationShape ;
      ] ;
    sh:property [
          sh:path epos:annotation ;
          sh:name 'Annotation' ;
          sh:description "Human-oriented description for the Annotation property in this shape."@en ;
          sh:node epos:AnnotationShape ;
      ] ;
.
epos:OrganizationShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:Organization;
    sh:name 'Organization' ;
    rdfs:label "Organization"@en  ;
    rdfs:comment "SHACL node shape for Organization."@en  ;
####
# Organization mandatory properties
####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Organization (e.g.,PIC, ISNI, etc.).";
          sh:or ([sh:datatype xsd:string; ]
                 [sh:datatype xsd:anyURI; ]
                 [sh:node epos:PropertyValueShape; ] ) ;
          sh:minCount 1 ;
      ] ;
####
# Organization recommended properties
####
    sh:property [
          sh:path schema:legalName;
          sh:name 'Legal Name' ;
          sh:description "This property contains the official name of the Organization.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;;
          sh:minCount 1 ;
          sh:message "LegalName is recommended. Please fill in a value"@en ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path schema:leiCode;
          sh:name 'LEI Code' ;
          sh:description "This property contains the Organization identifier that uniquely identifies a legal entity as defined in ISO 17442.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
          sh:minCount 1 ;
          sh:message "LeiCode is recommended. Please fill in a value"@en ;
          sh:severity sh:Warning ;
      ] ;
####
# Organization optional properties
####
    sh:property [
          sh:path epos:annotation ;
          sh:name 'Annotation' ;
          sh:description "Human-oriented description for the Annotation property in this shape."@en ;
          sh:node epos:AnnotationShape ;
      ] ;
    sh:property [
          sh:path schema:address;
          sh:name 'Address' ;
          sh:description "This property contains the physical address of the Organization.";
          sh:or ( [sh:datatype xsd:string ; ]
                  [ sh:node epos:PostalAddressShape; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:logo ;
          sh:name 'Logo' ;
          sh:description "This property contains the URL of the Organization logo.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:url ;
          sh:name 'URL' ;
          sh:description "This property contains the URL of the Organization website.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:email ;
          sh:name 'Email' ;
          sh:description "This property contains the email address of the Organization.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:telephone ;
          sh:name 'Telephone' ;
          sh:description "This property contains the telephone number of the Organization.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property refers to the Contact Point defined for the Organization.";
          sh:node epos:ContactPointType ;
      ] ;
    sh:property [
          sh:path schema:memberOf;
          sh:name 'Member Of' ;
          sh:description "This property refers to an Organization to which this Organization belongs.";
          sh:node epos:OrganizationShape ;
      ] ;
    sh:property [
          sh:path schema:owns;
          sh:name 'Owns' ;
          sh:description "This property refers to a Facility or Equipment of which it is the owner.";
          sh:or ( [ sh:node epos:FacilityShape ; ]
                  [ sh:node epos:EquipmentShape ; ] ) ;
      ] ;
    sh:property [
          sh:path epos:associatedProject;
          sh:name 'Associated Project' ;
          sh:description "This property refers to a Project in which the Organization is involved.";
          sh:node epos:ProjectShape ;
      ];
.

epos:ContactPointShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:ContactPoint;
    sh:name 'ContactPoint' ;
    rdfs:label "ContactPoint"@en  ;
    rdfs:comment "SHACL node shape for ContactPoint."@en  ;
####
# ContactPoint recommended properties
###
    sh:property [
          sh:path schema:contactType ;
          sh:name 'Contact Type' ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "contactType is recommended. Please fill in a value (e.g. legalContact, financialContact, scientificContact, manager)"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains information about the role of the Contact Point.";
          sh:maxCount 1 ;
      ] ;
####
# ContactPoint optional properties
####

    sh:property [
          sh:path schema:email ;
          sh:name 'Email' ;
          sh:description "This property contains the email address of the Contact Point.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:availableLanguage ;
          sh:name 'Available Language' ;
          sh:description "This property contains information about the language used by the Contact Point. Please use one of the language codes from the IETF BCP 47 standard.";
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:telephone ;
          sh:name 'Telephone' ;
          sh:description "This property contains the telephone number of the Contact Point.";
          sh:datatype xsd:string;
      ] ;
.
epos:WebServiceShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass epos:WebService;
    sh:name 'WebService' ;
    rdfs:label "WebService"@en  ;
    rdfs:comment "SHACL node shape for WebService."@en  ;
####
# WebService mandatory properties
####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Web Service.";
          sh:or ( [sh:datatype xsd:string; ]
                  [ sh:datatype xsd:anyURI; ]
                  [ sh:node epos:PropertyValueShape; ] ) ;
          sh:minCount 1 ;
      ] ;
####
# WebService recommended properties
####
    sh:property [
          sh:path schema:description ;
          sh:name 'Description' ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Description is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains a free-text description of the Web Service.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:theme;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Web Service. A Web Service may be associated with multiple themes.";
          sh:or ( [ sh:node epos:ConceptShape ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:message "Theme is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path schema:name ;
          sh:name 'Name' ;
          sh:description "This property contains a name given to the Web Service.";
          sh:maxCount 1 ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Name is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path hydra:entrypoint ;
          sh:name 'Entrypoint' ;
          sh:description "This property refers to the API definitions (e.g., WSDL, WADL)";
          sh:maxCount 1 ;
          sh:datatype xsd:anyURI;
          sh:minCount 1 ;
          sh:message "Entrypoint is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dcat:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property contains contact information that can be used for sending comments about the Web Service.";
          sh:node epos:ContactPointType ;
          sh:minCount 1;
          sh:message "Contact Point is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;

    sh:property [
          sh:path schema:provider;
          sh:name 'Provider' ;
          sh:description "This property refers to an Organisation responsible for making the Web Service available.";
          sh:or ( [ sh:node epos:OrganizationShape ; ]
                  [ sh:node epos:PersonShape ; ] ) ;
          sh:maxCount 1;
          sh:minCount 1;
          sh:message "Provider is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path schema:datePublished;
          sh:name 'Date Published' ;
          sh:minCount 1 ;
          sh:message "datePublished is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the date of publication of the Web Service.";
          sh:maxCount 1;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path schema:dateModified ;
          sh:name 'Date Modified' ;
          sh:minCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
          sh:message "Modified date is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the most recent date on which the Web Service was modified.";
          sh:maxCount 1;
      ] ;
####
# WebService optional properties
####
    sh:property [
          sh:path dct:spatial ;
          sh:name 'Spatial' ;
          sh:node epos:LocationShape ;
          sh:description "This property refers to a geographical area covered by the Web Service.";
      ] ;
    sh:property [
          sh:path hydra:supportedOperation ;
          sh:name 'Supported Operation' ;
          sh:description "This property refers to a web service operation supported by the Web Service.";
          sh:node epos:OperationShape ;
      ] ;
    sh:property [
          sh:path dct:conformsTo ;
          sh:name 'Conforms To' ;
          sh:description "This property refers to the API documentation.";
          sh:node epos:ApiDocumentationShape ;
      ] ;
    sh:property [
          sh:path schema:keywords;
          sh:name 'Keywords' ;
          sh:description "This property contains the keywords used to describe the Web Service. Multiple entries in a keywords list are typically delimited by commas.";
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path dct:license ;
          sh:name 'License' ;
          sh:description "This property refers to the licence under which the Web Service can be used or reused.";
          sh:or ( [ sh:class dct:LicenseDocument ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:temporal ;
          sh:name 'Temporal' ;
          sh:description "This property refers to a temporal period that the Web Service covers.";
          sh:node epos:PeriodOfTimeShape ;
      ] ;
.
epos:OperationShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass hydra:Operation;
    sh:name 'Operation' ;
    rdfs:label "Operation"@en  ;
    rdfs:comment "SHACL node shape for Operation."@en  ;

####
# Operation  recommended properties
####
    sh:property [
          sh:path hydra:property ;
          sh:name 'Property' ;
          sh:node epos:IriTemplateShape ;
          sh:minCount 1 ;
          sh:message "IRI template is recommended. Please fill in a value"@en ;
          sh:severity sh:Warning ;
          sh:description "This property refers to the IriTemplate of the Web Service operation. This describes the endpoint and parameters mapping for the operation.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path hydra:returns ;
          sh:name 'Returns' ;
          sh:description "This property is used to specify the output format of the Operation. The possible values are listed here: https://www.iana.org/assignments/media-types/media-types.xhtml";
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "returns is recommended. Please fill in a value"@en ;
          sh:severity sh:Warning ;
      ];

####
# Operation optional properties
####
    sh:property [
          sh:path hydra:method ;
          sh:name 'Method' ;
          sh:description "The HTTP method";
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
      ];
.

epos:IriTemplateShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass hydra:IriTemplate ;
    sh:name 'IriTemplate' ;
    rdfs:label "IriTemplate"@en  ;
    rdfs:comment "SHACL node shape for IriTemplate."@en  ;
####
# IriTemplate mandatory properties
####
    sh:property [
          sh:path hydra:template ;
          sh:name 'Template' ;
          sh:description "The syntax of the template literal is specified by the [ RFC6570] URI Template syntax.";
          sh:datatype xsd:string ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
####
# IriTemplate optional properties
####
    sh:property [
          sh:path hydra:mapping ;
          sh:name 'Mapping' ;
          sh:description "A variable-to-property mapping of the IRI template.";
          sh:node epos:IriTemplateMappingShape ;
      ] ;
.

epos:IriTemplateMappingShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass hydra:IriTemplateMapping ;
    sh:name 'IriTemplateMapping' ;
    rdfs:label "IriTemplateMapping"@en  ;
    rdfs:comment "SHACL node shape for IriTemplateMapping."@en  ;
####
# IriTemplateMapping mandatory properties
####
    sh:property [
          sh:path hydra:variable ;
          sh:name 'Variable' ;
          sh:description "This property contains the name of the parameter as required by web service specifications.";
          sh:datatype xsd:string ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path rdfs:label ;
          sh:name 'Label' ;
          sh:description "This property contains a short string used to describe the meaning of the parameter.";
          sh:datatype xsd:string ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path hydra:required ;
          sh:name 'Required' ;
          sh:description "This property contains true if the property is required, false otherwise.";
          sh:datatype xsd:boolean ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path rdfs:range ;
          sh:name 'Range' ;
          sh:description "This property contains the type of parameter (e.g., xsd:string, xsd:Boolean, xsd:date, xsd:dateTime).";
          sh:datatype xsd:string ;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
####
# IriTemplateMapping optional properties
####
    sh:property [
          sh:path schema:defaultValue ;
          sh:name 'Default Value' ;
          sh:description "This property contains the default value of the parameter.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:minValue ;
          sh:name 'Min Value' ;
          sh:description "This property contains the minimum value of the parameter.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:maxValue ;
          sh:name 'Max Value' ;
          sh:description "This property contains the maximum value of the parameter.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path http:paramValue ;
          sh:name 'Param Value' ;
          sh:description "This property contains one of the possible values which should be used in the web service query. It could be repeated as many times as needed.";
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path schema:multipleValues ;
          sh:name 'Multiple Values' ;
          sh:description "Whether multiple values are allowed for the property. Default is false.";
          sh:datatype xsd:boolean ;
      ] ;
    sh:property [
          sh:path schema:readonlyValue ;
          sh:name 'Readonly Value' ;
          sh:description "Whether or not a property is mutable. Default is false. Specifying this for a property that also has a value makes it act similar to a hidden input in an HTML form.";
          sh:datatype xsd:boolean ;
      ] ;
    sh:property [
          sh:path schema:valuePattern ;
          sh:name 'Value Pattern' ;
          sh:description "This property contains the regular expression for testing values according to the parameter's specification.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path hydra:property ;
          sh:name 'Property' ;
          sh:description "This property contains the vocabulary term which indicates the semantic description of parameter.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
.

epos:ServiceShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:Service;
    sh:name 'Service' ;
    rdfs:label "Service"@en  ;
    rdfs:comment "SHACL node shape for Service."@en  ;
####
# Service Mandatory properties
####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Service.";
          sh:or ( [ sh:datatype xsd:string; ]
                  [ sh:datatype xsd:anyURI; ]
                  [ sh:node epos:PropertyValueShape; ] ) ;
          sh:minCount 1 ;
      ] ;
####
# Service recommended properties
####
    sh:property [
          sh:path schema:name ;
          sh:name 'Name' ;
          sh:description "This property contains the name of the Service.";
          sh:maxCount 1 ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Name is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ];
    sh:property [
          sh:path schema:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property refers to the Contact Point defined for the Service.";
          sh:node epos:ContactPointType ;
          sh:minCount 1 ;
          sh:message "Contact point is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path schema:description;
          sh:name 'Description' ;
          sh:minCount 1 ;
          sh:datatype xsd:string;
          sh:message "Description is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the description of the Service.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:provider;
          sh:name 'Provider' ;
          sh:description "This property refers to an Organisation or Person responsible for making the Service available.";
          sh:maxCount 1;
          sh:or ( [ sh:node epos:OrganizationShape ; ]
                  [ sh:node epos:PersonShape ; ] ) ;
          sh:minCount 1;
          sh:message "Provider is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
####
# Service optional properties
###
    sh:property [
          sh:path schema:serviceType ;
          sh:name 'Service Type' ;
          sh:description "This property contains the type of service being offered.";
          sh:datatype xsd:string;
          sh:maxCount 1;
      ] ;
    sh:property [
          sh:path schema:keywords ;
          sh:name 'Keywords' ;
          sh:description "This property contains the keywords used to describe the Service. Multiple entries in a keywords list are typically delimited by commas.";
          sh:datatype xsd:string;
          sh:maxCount 1;
      ];
    sh:property [
          sh:path dcat:theme;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Service. A Service may be associated with multiple themes.";
          sh:node epos:ConceptShape ;
      ] ;
    sh:property [
          sh:path dct:temporal ;
          sh:name 'Temporal' ;
          sh:description "This property refers to a temporal period that the Service covers.";
          sh:node epos:PeriodOfTimeShape ;
      ] ;
    sh:property [
          sh:path dct:spatial ;
          sh:name 'Spatial' ;
          sh:description "This property refers to a geographical area covered by the Service.";
          sh:node epos:LocationShape ;
      ] ;
    sh:property [
          sh:path schema:url ;
          sh:name 'URL' ;
          sh:description "This property refers to the URL of the Service.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
.

epos:EquipmentShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass epos:Equipment;
    sh:name 'Equipment' ;
    rdfs:label "Equipment"@en  ;
    rdfs:comment "SHACL node shape for Equipment."@en  ;
####
# Equipment mandatory properties
####
    sh:property [
          sh:path schema:description ;
          sh:name 'Description' ;
          sh:description "This property contains a free-text description of the Equipment.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Equipment.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:name ;
          sh:name 'Name' ;
          sh:description "This property contains a name given to the Equipment.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
      ] ;
####
# Equipment recommended properties
####
    sh:property [
          sh:path dct:type ;
          sh:name 'Type' ;
          sh:minCount 1 ;
          sh:message "Type is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property refers to the type of the Equipment.";
          sh:or ( [ sh:datatype xsd:anyURI ; ]
                  [ sh:node epos:ConceptShape ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:manufacturer ;
          sh:name 'Manufacturer' ;
          sh:description "This property refers to an Organisation responsible for manufacturing the Equipment.";
          sh:node epos:OrganizationShape ;
          sh:maxCount 1 ;
          sh:minCount 1;
          sh:message "Manufacturer is recommended. Please fill in a value"@en ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path schema:serialNumber ;
          sh:name 'Serial Number' ;
          sh:description "This property contains the serial number for the Equipment.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
          sh:minCount 1 ;
          sh:message "SerialNumber is recommended. Please fill in a value"@en ;
          sh:severity sh:Warning ;
      ] ;
####
# Equipment optional properties
####
    sh:property [
          sh:path dct:isPartOf ;
          sh:name 'Is Part Of' ;
          sh:description "This property refers to an Equipment or a Facility in which the described Equipment is included.";
          sh:or ( [ sh:node epos:EquipmentShape ; ]
                  [ sh:node epos:FacilityShape ; ] ) ;
      ] ;
    sh:property [
          sh:path epos:filter ;
          sh:name 'Filter' ;
          sh:description "This property describes the filter that the instrument uses to produce data.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path epos:dynamicRange ;
          sh:name 'Dynamic Range' ;
          sh:description "This property contains the full-scale measuring ability, in nT (unit and value).";
          sh:node epos:QuantitativeValueShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path epos:orientation ;
          sh:name 'Orientation' ;
          sh:description "This property describes how the instrument is oriented.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path epos:resolution ;
          sh:name 'Resolution' ;
          sh:description "This property contains the resolution in nT.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path epos:samplePeriod ;
          sh:name 'Sample Period' ;
          sh:description "This property contains the sample period in mS (unit and value)";
          sh:node epos:QuantitativeValueShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property contains contact information that can be used for sending comments about the Equipment.";
          sh:node epos:ContactPointType ;
      ];
    sh:property [
          sh:path dct:spatial ;
          sh:name 'Spatial' ;
          sh:description "This property refers to a geographical location of the Equipment.";
          sh:node epos:LocationShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path epos:annotation ;
          sh:name 'Annotation' ;
          sh:description "Human-oriented description for the Annotation property in this shape."@en ;
          sh:node epos:AnnotationShape ;
      ] ;
    sh:property [
          sh:path dct:temporal ;
          sh:name 'Temporal' ;
          sh:description "This property contains the start and the end of the period. ";
          sh:node epos:PeriodOfTimeShape ;
      ] ;
    sh:property [
          sh:path dct:relation ;
          sh:name 'Relation' ;
          sh:description "This property refers to a related resource (e.g., Dataset, WebService, etc.).";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path dcat:theme ;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Equipment. An Equipment may be associated with multiple themes.";
          sh:node epos:ConceptShape ;
      ] ;
    sh:property [
          sh:path foaf:page ;
          sh:name 'Page' ;
          sh:description "This property refers to a web page about this Equipment.";
          sh:datatype xsd:anyURI ;
      ];
.

epos:DatasetShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass dcat:Dataset ;
    sh:name 'Dataset' ;
    rdfs:label "Dataset"@en  ;
    rdfs:comment "SHACL node shape for Dataset."@en  ;
