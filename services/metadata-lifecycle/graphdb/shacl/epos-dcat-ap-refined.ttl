          sh:path schema:startDate ;
          sh:name 'Start Date' ;
          sh:description "This property contains the start of the period."  ;
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path schema:endDate ;
          sh:name 'End Date' ;
          sh:description "This property contains the end of the period."  ;
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
.

epos:PostalAddressShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:PostalAddress;
    sh:name 'Postal Address' ;
    rdfs:label "Postal Address"@en  ;
    rdfs:comment "SHACL node shape for Postal Address."@en  ;
    ####
    # PostalAddress properties
    ####
    sh:property [
          sh:path schema:streetAddress ;
          sh:name 'Street Address' ;
          sh:description "The street address. For example, 1600 Amphitheatre Pkwy.";
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:addressLocality ;
          sh:name 'Address Locality' ;
          sh:description "The locality in which the street address is, and which is in the region. For example, Mountain View.";
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:postalCode ;
          sh:name 'Postal Code' ;
          sh:description "The postal code. For example, 94043.";
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:addressCountry ;
          sh:name 'Address Country' ;
          sh:description "The country. For example, USA. You can also provide the two-letter ISO 3166-1 alpha-2 country code.";
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ];
.

epos:QuantitativeValueShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:QuantitativeValue ;
    sh:name 'Quantitative Value' ;
    rdfs:label "Quantitative Value"@en  ;
    rdfs:comment "SHACL node shape for Quantitative Value."@en  ;
    ####
    # QuantitativeValue properties
    ####
    sh:property [
          sh:path schema:unitCode ;
          sh:name 'Unit Code' ;
          sh:description "The unit of measurement given using the UN/CEFACT Common Code (3 characters) or a URL. Other codes than the UN/CEFACT Common Code may be used with a prefix followed by a colon.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path schema:value ;
          sh:name 'Value' ;
          sh:description "The value of the quantitative value or property value node.The recommended type for values is 'Number'.";
          sh:datatype xsd:double;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
.

epos:LocationShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass dct:Location ;
    sh:name 'Location' ;
    rdfs:label "Location"@en  ;
    rdfs:comment "SHACL node shape for Location."@en  ;
####
# Location properties
####
    sh:property [
          sh:path locn:geometry ;
          sh:name 'Geometry' ;
          sh:description "This property associates any resource with the corresponding geometry.";
          sh:datatype gsp:wktLiteral;
          sh:minCount 1 ;
      ] ;
.

epos:IdentifierShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass adms:Identifier;
    sh:name 'Identifier' ;
    rdfs:label "Identifier"@en  ;
    rdfs:comment "SHACL node shape for Identifier."@en  ;
####
# Identifier properties
####
    sh:property [
          sh:path adms:schemeAgency ;
          sh:name 'Scheme Agency' ;
          sh:description "This property refers the identifier scheme referenced by its datatype (e.g., DDSS-ID, DOI, etc.).";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path skos:notation ;
          sh:name 'Notation' ;
          sh:description "This property contains a string that is an identifier in the context of the identifier scheme referenced by its datatype.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
.

epos:PropertyValueShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:PropertyValue ;
    sh:name 'Property Value' ;
    rdfs:label "Property Value"@en  ;
    rdfs:comment "SHACL node shape for Property Value."@en  ;
####
# PropertyValue properties
####
    sh:property [
          sh:path schema:propertyID ;
          sh:name 'Property ID' ;
          sh:description "A commonly used identifier for the characteristic represented by the property, e.g. a manufacturer or a standard code for a property. propertyID can be (1) a prefixed string, mainly meant to be used with standards for product properties; (2) a site-specific, non-prefixed string (e.g. the primary key of the property or the vendor-specific id of the property), or (3) a URL indicating the type of the property, either pointing to an external vocabulary, or a Web resource that describes the property (e.g. a glossary entry). Standards bodies should promote a standard prefix for the identifiers of properties from their standards.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path schema:value ;
          sh:name 'Value' ;
          sh:description "The value of the quantitative value or property value node. The recommended type for values is 'Number'.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
.

epos:ConceptSchemeShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass skos:ConceptScheme ;
    sh:name 'Concept Scheme' ;
    rdfs:label "Concept Scheme"@en  ;
    rdfs:comment "SHACL node shape for Concept Scheme."@en  ;
####
# ConceptScheme properties
####
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Title is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains a name of the category scheme.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:description ;
          sh:name 'Description' ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Description is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains a description of the category scheme.";
          sh:maxCount 1 ;
      ] ;
.
epos:ConceptShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass skos:Concept ;
    sh:name 'Concept' ;
    rdfs:label "Concept"@en  ;
    rdfs:comment "SHACL node shape for Concept."@en  ;
####
# Concept properties
####
    sh:property [
          sh:path skos:definition ;
          sh:name 'Definition' ;
          sh:description "This property contains a statement or formal explanation of the meaning of a concept." ;
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path skos:prefLabel ;
          sh:name 'Pref Label' ;
          sh:description "This property contains a preferred label of the category. This property can be repeated for parallel language versions of the label.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path skos:inScheme;
          sh:name 'In Scheme' ;
          sh:description "Relates a resource (for example a concept) to a concept scheme in which it is included." ;
          sh:node epos:ConceptSchemeShape ;
          sh:maxCount 1 ;
          sh:minCount 1 ;
      ] ;
.
