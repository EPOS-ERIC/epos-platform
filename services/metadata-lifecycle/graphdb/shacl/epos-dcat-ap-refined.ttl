          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:description "This property contains a name given to the Dataset. This property can be repeated for parallel language versions of the name.";
          sh:minCount 1 ;
          sh:datatype xsd:string ;
      ] ;
####
# Dataset recommended properties
####
    sh:property [
          sh:path dcat:distribution ;
          sh:name 'Distribution' ;
          sh:description "This property links the Dataset to an available Distribution.";
          sh:minCount 1 ;
          sh:node epos:DistributionShape ;
          sh:message "Distribution is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dcat:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property contains contact information that can be used for sending comments about the Dataset.";
          sh:minCount 1 ;
          sh:node epos:ContactPointType ;
          sh:message "Contact point is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dct:publisher ;
          sh:name 'Publisher' ;
          sh:description "This property refers to an entity (organisation) responsible for making the Dataset available.";
          sh:minCount 1 ;
          sh:or ( [ sh:node epos:AgentShape ; ]
                  [ sh:node epos:OrganizationShape ; ] ) ;
          sh:message "Publisher is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dcat:keyword ;
          sh:name 'Keyword' ;
          sh:description "This property contains a keyword or tag describing the Dataset.";
          sh:minCount 1 ;
          sh:datatype xsd:string ;
          sh:message "Keyword is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dcat:theme ;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Dataset. A Dataset may be associated with multiple themes.";
          sh:or ( [ sh:node epos:ConceptShape ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:message "Theme is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
####
# Dataset optional properties
####
    sh:property [
          sh:path dct:created ;
          sh:name 'Created' ;
          sh:description "This property contains the date on which the Dataset was created.";
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path dct:type ;
          sh:name 'Type' ;
          sh:description "This property refers to the type of the Dataset. A controlled vocabulary for the values has not been established.";
          sh:datatype xsd:anyURI ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:accessRights ;
          sh:name 'Access Rights' ;
          sh:description "This property refers to information that indicates whether the Dataset is open data, has access restrictions or is not public. A controlled vocabulary with three members (:public, :restricted, :non-public) will be created and maintained by the Publications Office of the EU.";
          sh:or ( [ sh:class dct:RightsStatement ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:accrualPeriodicity ;
          sh:name 'Accrual Periodicity' ;
          sh:description "This property refers to the frequency at which the Dataset is updated.";
          #sh:class dct:Frequency ;
          sh:datatype xsd:anyURI ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:conformsTo ;
          sh:name 'Conforms To' ;
          sh:description "This property refers to an implementing rule or other specification.";
          sh:or ( [ sh:class dct:Standard ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
      ] ;
    sh:property [
          sh:path dct:hasVersion ;
          sh:name 'Has Version' ;
          sh:description "This property refers to a related Dataset that is a version, edition, or adaptation of the described Dataset.";
          sh:node epos:DatasetShape ;
      ] ;
    sh:property [
          sh:path dct:isVersionOf ;
          sh:name 'Is Version Of' ;
          sh:description "This property refers to a related Dataset of which the described Dataset is a version, edition, or adaptation.";
          sh:node epos:DatasetShape ;
      ] ;
    sh:property [
          sh:path dct:issued ;
          sh:name 'Issued' ;
          sh:description "This property contains the date of formal issuance (e.g., publication) of the Dataset.";
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path dct:modified ;
          sh:name 'Modified' ;
          sh:description "This property contains the most recent date on which the Dataset was changed or modified.";
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path dct:language ;
          sh:name 'Language' ;
          sh:description "This property refers to a language of the Dataset. This property can be repeated if there are multiple languages in the Dataset.";
          sh:or ( [ sh:class dct:LinguisticSystem ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
      ] ;
    sh:property [
          sh:path dct:provenance ;
          sh:name 'Provenance' ;
          sh:description "This property contains a statement about the lineage of a Dataset.";
          sh:or ( [ sh:class dct:ProvenanceStatement ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
      ] ;
    sh:property [
          sh:path dct:relation ;
          sh:name 'Relation' ;
          sh:description "This property refers to a related resource.";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path dct:source ;
          sh:name 'Source' ;
          sh:description "This property refers to a related Dataset from which the described Dataset is derived.";
          sh:node epos:DatasetShape ;
      ] ;
    sh:property [
          sh:path dct:spatial ;
          sh:name 'Spatial' ;
          sh:description "This property refers to a geographic region that is covered by the Dataset.";
          sh:node epos:LocationShape ;
      ] ;
    sh:property [
          sh:path dct:temporal ;
          sh:name 'Temporal' ;
          sh:description "This property refers to a temporal period that the Dataset covers.";
          sh:node epos:PeriodOfTimeShape ;
      ] ;
    sh:property [
          sh:path owl:versionInfo ;
          sh:name 'Version Info' ;
          sh:description "This property contains a version number or other version designation of the Dataset.";
          sh:maxCount 1 ;
          sh:datatype xsd:string;
      ] ;
    sh:property [
          sh:path adms:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property refers to a secondary identifier of the Dataset, such as MAST/ADS, DataCite, DOI, EZID or W3ID.";
          sh:node epos:IdentifierShape ;
      ] ;
    sh:property [
          sh:path adms:sample ;
          sh:name 'Sample' ;
          sh:description "This property refers to a sample distribution of the dataset";
          sh:node epos:DistributionShape ;
      ] ;
    sh:property [
          sh:path dcat:landingPage ;
          sh:name 'Landing Page' ;
          sh:description "This property refers to a web page that provides access to the Dataset, its Distributions and/or additional information. It is intended to point to a landing page at the original data provider, not to a page on a site of a third party, such as an aggregator.";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path foaf:page ;
          sh:name 'Page' ;
          sh:description "This property refers to a page or document about this Dataset.";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path adms:versionNotes ;
          sh:name 'Version Notes' ;
          sh:description "This property contains a description of the differences between this version and a previous version of the Dataset. This property can be repeated for parallel language versions of the version notes.";
          sh:datatype xsd:string ;
      ] ;
## Support for collections of datasets
    sh:property [
          sh:path dct:isPartOf ;
          sh:name 'Is Part Of' ;
          sh:description "This property refers to a related Dataset in which the described Dataset is physically or logically included.";
          sh:node epos:DatasetShape ;
      ] ;
    sh:property [
          sh:path dct:hasPart ;
          sh:name 'Has Part' ;
          sh:description "This property refers to a related Dataset that is part of the described Dataset.";
          sh:node epos:DatasetShape ;
      ] ;
    sh:property [
          sh:path dqv:hasQualityAnnotation ;
          sh:name 'Has Quality Annotation' ;
          sh:description "This property refers to a statement related to quality of the Dataset, including rating, quality certificate that can be associated to the Dataset. ";
          sh:node epos:AnnotationShape ;
      ] ;
    sh:property [
          sh:path epos:annotation ;
          sh:name 'Annotation' ;
          sh:description "Human-oriented description for the Annotation property in this shape."@en ;
          sh:node epos:AnnotationShape ;
      ] ;
.
epos:FacilityShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass epos:Facility ;
    sh:name 'Facility' ;
    rdfs:label "Facility"@en  ;
    rdfs:comment "SHACL node shape for Facility."@en  ;
####
# Facility mandatory properties
####
    sh:property [
          sh:path dct:description ;
          sh:name 'Description' ;
          sh:description "This property contains a free-text description of the Facility.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path dct:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Facility.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:description "This property contains a name given to the Facility.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
      ] ;
####
# Facility recommended properties
####
    sh:property [
          sh:path dct:type ;
          sh:name 'Type' ;
          sh:minCount 1 ;
          sh:or ( [ sh:datatype xsd:anyURI ; ]
                  [ sh:node epos:ConceptShape ; ] ) ;
          sh:message "Type is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property refers to the type of the Facility.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:theme;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Facility. A Facility may be associated with multiple themes.";
          sh:node epos:ConceptShape ;
          sh:minCount 1 ;
          sh:message "Theme is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    ####
    # Facility optional properties
    ####
    sh:property [
          sh:path dct:isPartOf ;
          sh:name 'Is Part Of' ;
          sh:description "This property refers to a Facility in which the described Facility is included.";
          sh:node epos:FacilityShape ;
      ] ;
    sh:property [
          sh:path vcard:hasAddress ;
          sh:name 'Has Address' ;
          sh:description "This property contains the physical address of the Facility.";
          sh:node epos:AddressShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path foaf:page ;
          sh:name 'Page' ;
          sh:description "This property refers to a page or document about this Facility.";
          sh:datatype xsd:anyURI ;
      ] ;
    sh:property [
          sh:path dcat:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property contains contact information that can be used for sending comments about the Facility.";
          sh:node epos:ContactPointType ;
      ] ;
    sh:property [
          sh:path dct:relation ;
          sh:name 'Relation' ;
          sh:description "This property refers to a related resource (e.g., Dataset, WebService, etc).";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path epos:annotation ;
          sh:name 'Annotation' ;
          sh:description "Human-oriented description for the Annotation property in this shape."@en ;
          sh:node epos:AnnotationShape ;
      ] ;
    sh:property [
          sh:path dct:spatial ;
          sh:name 'Spatial' ;
          sh:description "This property refers to the geographical coordinates of the facility.";
          sh:node epos:LocationShape ;
          sh:maxCount 1 ;
      ] ;
.
epos:DistributionShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass dcat:Distribution;
    sh:name 'Distribution' ;
    rdfs:label "Distribution"@en  ;
    rdfs:comment "SHACL node shape for Distribution."@en  ;
    ####
    # Distribution mandatory properties
    ####
    sh:property [
          sh:path dct:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Distribution.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:accessURL ;
          sh:name 'Access URL' ;
          sh:description "This property contains a URL that gives access to a Distribution of the Dataset. The resource at the access URL may contain information about how to get the Dataset.";
          sh:or ( [ sh:class rdfs:Resource ; ]
                  [ sh:node epos:OperationShape ; ]
                  [ sh:datatype xsd:anyURI ; ] ) ;
          sh:minCount 1 ;
      ] ;
    ####
    # Distribution recommended properties
    ####
    sh:property [
          sh:path dct:conformsTo ;
          sh:name 'Conforms To' ;
          sh:description "This property refers to an established schema to which the described Distribution conforms.";
          sh:or ( [ sh:class dct:Standard ; ]
                  [ sh:node epos:WebServiceShape ; ] ) ;
          sh:minCount 1 ;
          sh:message "conformsTo is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dct:type ;
          sh:name 'Type' ;
          sh:minCount 1 ;
          sh:datatype xsd:anyURI;
          sh:message "Type is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property refers to the type of the Distribution.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:description ;
          sh:name 'Description' ;
          sh:description "This property contains a free-text account of the Distribution. This property can be repeated for parallel language versions of the description.";
          sh:minCount 1 ;
          sh:datatype xsd:string ;
          sh:message "Description is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dct:format ;
          sh:name 'Format' ;
          sh:description "This property refers to the file format of the Distribution.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:format ;
          sh:name 'Format' ;
          sh:description "Human-oriented description for the Format property in this shape."@en ;
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:message "Format is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    ####
    # Distribution optional properties
    ####
    sh:property [
          sh:path dct:issued ;
          sh:name 'Issued' ;
          sh:description "This property contains the date of formal issuance (e.g., publication) of the Distribution.";
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path dct:language ;
          sh:name 'Language' ;
          sh:description "This property refers to a language used in the Distribution. This property can be repeated if the metadata is provided in multiple languages.";
          sh:or ( [ sh:class dct:LinguisticSystem ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
      ] ;
    sh:property [
          sh:path dct:license ;
          sh:name 'License' ;
          sh:description "This property refers to the licence under which the Distribution is made available.";
          sh:or ( [ sh:class dct:LicenseDocument ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:modified ;
          sh:name 'Modified' ;
          sh:description "This property contains the most recent date on which the Distribution was changed or modified.";
          sh:maxCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
      ] ;
    sh:property [
          sh:path dct:rights ;
          sh:name 'Rights' ;
          sh:description "This property refers to a statement that specifies rights associated with the Distribution.";
          sh:or ( [ sh:class dct:RightsStatement ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:description "This property contains a name given to the Distribution. This property can be repeated for parallel language versions of the description.";
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path spdx:checksum ;
          sh:name 'Checksum' ;
          sh:description "This property provides a mechanism that can be used to verify that the contents of a distribution have not changed";
          sh:or ( [ sh:class spdx:Checksum ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path adms:status ;
          sh:name 'Status' ;
          sh:description "This property refers to the maturity of the Distribution";
          sh:node epos:ConceptShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:byteSize ;
          sh:name 'Byte Size' ;
          sh:description "This property contains the size of a Distribution in bytes.";
          sh:datatype xsd:decimal ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:downloadURL ;
          sh:name 'Download URL' ;
          sh:description "This property contains a URL that is a direct link to a downloadable file in a given format.";
          #sh:class rdfs:Resource ;
          sh:datatype xsd:anyURI ;
      ] ;
    sh:property [
          sh:path dcat:mediaType ;
          sh:name 'Media Type' ;
          sh:description "This property refers to the media type of the Distribution as defined in the official register of media types managed by IANA.";
          sh:or ( [ sh:class dct:MediaTypeOrExtent ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:datatype xsd:string ; ] ) ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path foaf:page ;
          sh:name 'Page' ;
          sh:description "This property refers to a page or document about this Distribution.";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path epos:annotation ;
          sh:name 'Annotation' ;
          sh:description "Human-oriented description for the Annotation property in this shape."@en ;
          sh:node epos:AnnotationShape ;
      ] ;
.
epos:ProjectShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass foaf:Project;
    sh:name 'Project' ;
    rdfs:label "Project"@en  ;
    rdfs:comment "SHACL node shape for Project."@en  ;
    ####
    # Project mandatory properties
    ####
    sh:property [
          sh:path dct:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Project.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:minCount 1 ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:title ;
          sh:name 'Title' ;
          sh:description "This property contains the title of the Project.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
      ] ;
    ####
    # Project recommended properties
    ####

    sh:property [
          sh:path dcat:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property refers to the Contact Point defined for the Project.";
          sh:node epos:ContactPointType ;
          sh:minCount 1 ;
          sh:message "Contact point is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dct:description ;
          sh:name 'Description' ;
          sh:minCount 1 ;
          sh:datatype xsd:string;
          sh:message "Description is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the description of the Project.";
          sh:maxCount 1 ;
      ] ;
    ####
    # Project optional properties
    ####
    sh:property [
          sh:path foaf:homepage ;
          sh:name 'Homepage' ;
          sh:description "This property refers to a web page that acts as the main page for the Project.";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
          sh:maxCount 1 ;
      ] ;
.
epos:PublicationShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass epos:Publication;
    sh:name 'Publication' ;
    rdfs:label "Publication"@en  ;
    rdfs:comment "SHACL node shape for Publication."@en  ;
    ####
    # Publication mandatory properties
    ####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Publication.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ]
                  [ sh:node epos:PropertyValueShape ; ] ) ;
          sh:minCount 1 ;
      ] ;
    sh:property [
          sh:path schema:name ;
          sh:name 'Name' ;
          sh:description "This property contains the name of the Publication.";
          sh:minCount 1 ;
          sh:maxCount 1 ;
          sh:datatype xsd:string ;
      ] ;
    ####
    # Publication recommended properties
    ####
    sh:property [
          sh:path schema:datePublished ;
          sh:name 'Date Published' ;
          sh:minCount 1 ;
          sh:node epos:DateOrDateTimeDataType ;
          sh:message "Published date is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the date of first Publication.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:publisher ;
          sh:name 'Publisher' ;
          sh:description "This property refers to an organization or person or agent which is the publisher of the Publication.";
          sh:or ( [ sh:node epos:PersonShape ; ]
                  [ sh:node epos:OrganizationShape ; ]
                  [ sh:node epos:AgentShape ; ] ) ;
          sh:maxCount 1;
          sh:minCount 1 ;
          sh:message "Publisher is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path dct:abstract ;
          sh:name 'Abstract' ;
          sh:minCount 1 ;
          sh:datatype xsd:string;
          sh:message "Abstract is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the abstract of the Publication.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:author ;
          sh:name 'Author' ;
          sh:description "This property refers to a Person which is the author of the Publication.";
          sh:node epos:PersonShape ;
          sh:maxCount 1 ;
          sh:minCount 1 ;
          sh:message "Author is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    sh:property [
          sh:path schema:contributor ;
          sh:name 'Contributor' ;
          sh:description "This property refers to a Person which is a contributor of the Publication.";
          sh:node epos:PersonShape ;
          sh:minCount 1 ;
          sh:message "Contributor is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    ####
    # Publication optional properties
    ####
    sh:property [
          sh:path schema:license ;
          sh:name 'License' ;
          sh:description "This property contains the URL of the license document that applies to the Publication.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:keywords;
          sh:name 'Keywords' ;
          sh:description "This property contains the keywords used to describe the Publication. Multiple entries in a keywords list are typically delimited by commas.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:issn ;
          sh:name 'ISSN' ;
          sh:description "This property contains the International Standard Serial Number (ISSN) that identifies the Publication.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:numberOfPages ;
          sh:name 'Number Of Pages' ;
          sh:description "This property contains the number of pages of the Publication.";
          sh:datatype xsd:integer;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:volumeNumber ;
          sh:name 'Volume Number' ;
          sh:description "This property contains the volume identifier of the Publication.";
          sh:datatype xsd:string;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dcat:theme;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Publication. A Publication may be associated with multiple themes.";
          sh:node epos:ConceptShape ;
      ] ;
.
epos:SoftwareApplicationShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:SoftwareApplication;
    sh:name 'Software Application' ;
    rdfs:label "Software Application"@en  ;
    rdfs:comment "SHACL node shape for Software Application."@en  ;
    ####
    # SoftwareApplication mandatory properties
    ####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Software Application.";
          sh:or ( [ sh:datatype xsd:string; ]
                  [ sh:datatype xsd:anyURI; ]
                  [sh:node epos:PropertyValueShape; ] ) ;
          sh:minCount 1 ;
      ] ;
    ####
    # SoftwareApplication recommended properties
    ####
    sh:property [
          sh:path schema:name ;
          sh:name 'Name' ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Name is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the name of the Software Application.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property refers to the Contact Point defined for the Software Application.";
          sh:node epos:ContactPointType ;
          sh:minCount 1 ;
          sh:message "Contact point is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    ####
    # SoftwareApplication optional properties
    ####
    sh:property [
          sh:path schema:description ;
          sh:name 'Description' ;
          sh:description "This property contains the description of the Software Application.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:downloadUrl ;
          sh:name 'Download URL' ;
          sh:description "If the Software Application can be downloaded this property contains the URL to download it.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:license ;
          sh:name 'License' ;
          sh:description "This property contains the URL of the license document that applies to the Software Application.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:softwareVersion;
          sh:name 'Software Version' ;
          sh:description "This property contains the version of the Software Application instance.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:softwareRequirements ;
          sh:name 'Software Requirements' ;
          sh:description "Component dependency requirements for application. This includes runtime environments and shared libraries that are not included in the application distribution package, but required to run the application.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:potentialAction ;
          sh:name 'Potential Action' ;
          sh:description "This property describes the object upon which the action is carried out and the result produced in the action.";
          sh:node epos:ControlActionShape ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path dct:relation ;
          sh:name 'Relation' ;
          sh:description "This property refers to the WebService Operation linked to the application.";
          sh:datatype xsd:anyURI ;
          sh:nodeKind sh:IRI ;
      ] ;
    sh:property [
          sh:path schema:installUrl ;
          sh:name 'Install URL' ;
          sh:description "This property contains the URL at which the application may be installed.";
          sh:datatype xsd:anyURI;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:mainEntityOfPage ;
          sh:name 'Main Entity Of Page' ;
          sh:description "This property refers to the web page URL which describes the Software Application.";
          sh:datatype xsd:anyURI ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:keywords ;
          sh:name 'Keywords' ;
          sh:description "This property contains the keywords used to describe the Software Application. Multiple entries in a keywords list are typically delimited by commas.";
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path dcat:theme;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Software Application. A Software may be associated with multiple themes.";
          sh:node epos:ConceptShape ;
      ] ;
.

epos:ControlActionShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:ControlAction ;
    sh:name 'Control Action' ;
    rdfs:label "Control Action"@en  ;
    rdfs:comment "SHACL node shape for Control Action."@en  ;
    ####
    # ControlAction optional properties
    ####
    sh:property [
          sh:path schema:object ;
          sh:name 'Object' ;
          sh:description "The object upon which the action is carried out, whose state is kept intact or changed. Also known as the semantic roles patient, affected or undergoer (which change their state) or theme (which doesn't). e.g. John read a book.";
          sh:node epos:CreativeWorkShape ;
      ] ;
    sh:property [
          sh:path schema:result ;
          sh:name 'Result' ;
          sh:description "The result produced in the action. e.g. John wrote a book.";
          sh:node epos:CreativeWorkShape ;
      ] ;
.

epos:CreativeWorkShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:CreativeWork ;
    sh:name 'Creative Work' ;
    rdfs:label "Creative Work"@en  ;
    rdfs:comment "SHACL node shape for Creative Work."@en  ;
    ####
    # CreativeWork optional properties
    ####
    sh:property [
          sh:path schema:encodingFormat ;
          sh:name 'Encoding Format' ;
          sh:description "Media type typically expressed using a MIME format (see IANA site and MDN reference) e.g. application/zip for a SoftwareApplication binary, audio/mpeg for .mp3 etc.).";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
      ] ;
    sh:property [
          sh:path dct:conformsTo ;
          sh:name 'Conforms To' ;
          sh:description "This property refers to an established standard or specification that the resource conforms to.";
          sh:or ( [ sh:datatype xsd:string ; ]
                  [ sh:datatype xsd:anyURI ; ] );
      ] ;
.

epos:SoftwareSourceCodeShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass schema:SoftwareSourceCode;
    sh:name 'Software Sourcecode' ;
    rdfs:label "Software Sourcecode"@en  ;
    rdfs:comment "SHACL node shape for Software Sourcecode."@en  ;
    ####
    # SoftwareSourceCode mandatory properties
    ####
    sh:property [
          sh:path schema:identifier ;
          sh:name 'Identifier' ;
          sh:description "This property contains the main identifier for the Software Source Code.";
          sh:or ( [ sh:datatype xsd:string; ]
                  [ sh:datatype xsd:anyURI; ]
                  [sh:node epos:PropertyValueShape; ] ) ;
          sh:minCount 1 ;
      ] ;
    ####
    # SoftwareSourceCode recommended properties
    ####
    sh:property [
          sh:path schema:name ;
          sh:name 'Name' ;
          sh:datatype xsd:string;
          sh:minCount 1 ;
          sh:message "Name is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
          sh:description "This property contains the name of the Software Source Code.";
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:contactPoint ;
          sh:name 'Contact Point' ;
          sh:description "This property refers to the Contact Point defined for the Software Source Code.";
          sh:node epos:ContactPointType ;
          sh:minCount 1 ;
          sh:message "Contact point is recommended. Please fill in a value"@en  ;
          sh:severity sh:Warning ;
      ] ;
    ####
    # SoftwareSourceCode optional properties
    ####
    sh:property [
          sh:path schema:description ;
          sh:name 'Description' ;
          sh:description "This property contains the description of the Software Source Code.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:codeRepository ;
          sh:name 'Code Repository' ;
          sh:description "This property contains the link to the repository where the uncompiled, human readable code and related code is located (SVN, GitHub, CodePlex).";
          sh:datatype xsd:anyURI ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:license ;
          sh:name 'License' ;
          sh:description "This property contains the URL of the license document that applies to the Software Source Code.";
          sh:datatype xsd:anyURI ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:softwareVersion;
          sh:name 'Software Version' ;
          sh:description "This property contains the version of the Software Source Code instance.";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:programmingLanguage;
          sh:name 'Programming Language' ;
          sh:description "This property contains the computer programming language used to develop the Software Source Code.";
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path schema:runtimePlatform ;
          sh:name 'Runtime Platform' ;
          sh:description "This property refers to the runtime platform or script interpreter dependencies (Example - Java v1, Python2.3, .Net Framework 3.0).";
          sh:datatype xsd:string ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:targetProduct ;
          sh:name 'Target Product' ;
          sh:description "This property refers the target Operating System / Product to which the code applies. If applies to several versions, just the product name can be used.";
          sh:node epos:SoftwareApplicationShape ;
      ] ;
    sh:property [
          sh:path schema:mainEntityOfPage ;
          sh:name 'Main Entity Of Page' ;
          sh:description "This property refers to the web page URL which describes the Software Source Code.";
          sh:datatype xsd:anyURI ;
          sh:maxCount 1 ;
      ] ;
    sh:property [
          sh:path schema:keywords ;
          sh:name 'Keywords' ;
          sh:description "This property contains the keywords used to describe the Software Source Code. Multiple entries in a keywords list are typically delimited by commas.";
          sh:datatype xsd:string ;
      ] ;
    sh:property [
          sh:path dcat:theme;
          sh:name 'Theme' ;
          sh:description "This property refers to a category of the Software Source Code. A Software may be associated with multiple themes.";
          sh:node epos:ConceptShape ;
      ] ;
.

epos:PeriodOfTimeShape
    a sh:NodeShape,  rdfs:Class ;
    sh:targetClass dct:PeriodOfTime ;
    sh:name 'Period of Time' ;
    rdfs:label "Period of Time"@en  ;
    rdfs:comment "SHACL node shape for Period of Time."@en  ;
