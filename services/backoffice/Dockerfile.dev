FROM golang:1.27-alpine

RUN apk add --no-cache git curl make

WORKDIR /workspace/services/backoffice

COPY services/backoffice/go.mod services/backoffice/go.sum ./
COPY packages/go/logging /workspace/packages/go/logging
COPY packages/go/observability /workspace/packages/go/observability
COPY packages/go/middleware /workspace/packages/go/middleware
COPY packages/go/apidocs /workspace/packages/go/apidocs
COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh

RUN go mod download

COPY services/backoffice /workspace/services/backoffice

EXPOSE 5000

ENV EPOS_SERVICE_NAME="Backoffice" \
    EPOS_PORT="5000"

RUN adduser -D -u 1000 appuser && chown -R 1000:1000 /workspace
USER 1000

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["make", "dev"]
