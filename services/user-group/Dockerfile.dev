FROM golang:1.26-alpine3.22

RUN apk add --no-cache git curl

WORKDIR /workspace/services/user-group

COPY services/user-group/go.mod services/user-group/go.sum ./
COPY packages/go/logging /workspace/packages/go/logging
COPY packages/go/observability /workspace/packages/go/observability
COPY packages/go/middleware /workspace/packages/go/middleware
COPY packages/go/apidocs /workspace/packages/go/apidocs
COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh

RUN go mod download

COPY services/user-group /workspace/services/user-group

EXPOSE 8090

ENV EPOS_SERVICE_NAME="User Group" \
    EPOS_PORT="8090"

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["go", "run", "."]
