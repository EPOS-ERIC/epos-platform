FROM golang:1.26.2

WORKDIR /workspace/services/data-retriever

ENV CGO_ENABLED=0

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/data-retriever/go.mod services/data-retriever/go.sum ./
COPY packages/go/logging /workspace/packages/go/logging
COPY packages/go/observability /workspace/packages/go/observability
COPY packages/go/migrations /workspace/packages/go/migrations
COPY packages/go/postgres /workspace/packages/go/postgres
COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh
RUN go mod download

COPY services/data-retriever/ ./

EXPOSE 8100

ENV EPOS_SERVICE_NAME="Data Retriever" \
    EPOS_PORT="8100"

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["go", "run", "."]
