FROM golang:1.27-alpine

WORKDIR /workspace/services/data-retriever

ENV CGO_ENABLED=0

RUN apk add --no-cache make

COPY packages/scripts/epos-banner.sh /usr/local/bin/epos-banner.sh
COPY . /workspace

EXPOSE 8100

ENV EPOS_SERVICE_NAME="Data Retriever" \
    EPOS_PORT="8100"

ENTRYPOINT ["/bin/sh", "/usr/local/bin/epos-banner.sh"]
CMD ["make", "dev"]
