{
    "$schema": "https://opencode.ai/config.json",
    "mcp": {
        "grafana": {
            "type": "local",
            "command": [
                "uvx",
                "mcp-grafana",
                "-t",
                "stdio"
            ],
            "environment": {
                "GRAFANA_URL": "http://localhost:3000"
            },
            "enabled": true
        }
    }
}
