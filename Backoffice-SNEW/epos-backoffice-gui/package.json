{
  "name": "epos-backoffice-gui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "pnpm run codegen && ng serve --configuration development",
    "dev-oss": "pnpm run codegen && ng serve --configuration oss-development",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "codegen": "openapi-codegen gen backoffice"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "dependencies": {
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@terraformer/wkt": "2.2.2",
    "@types/leaflet": "^1.9.22",
    "angular-oauth2-oidc": "21.0.3",
    "angular-oauth2-oidc-jwks": "21.0.3",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.1.2",
    "@angular/cli": "^21.1.2",
    "@angular/compiler-cli": "^21.1.0",
    "@openapi-codegen/cli": "^3.0.1",
    "@openapi-codegen/typescript": "^8.0.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^26.4.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
